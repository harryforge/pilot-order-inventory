{
  "name": "@pilot/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:integration": "node --env-file-if-exists=../../.env --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js -c jest.integration.config.js --runInBand",
    "migration:run": "pnpm build && node --env-file-if-exists=../../.env node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "migration:revert": "pnpm build && node --env-file-if-exists=../../.env node_modules/typeorm/cli.js migration:revert -d dist/data-source.js",
    "seed": "pnpm build && node --env-file-if-exists=../../.env dist/seed/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/typeorm": "12.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.7",
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  },
  "type": "module"
}
